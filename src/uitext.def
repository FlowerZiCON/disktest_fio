UI_TEXT(kLogErrorPrefix, "错误：%1")
UI_TEXT(kLogWarnPrefix, "警告：%1")
#ifdef Q_OS_WIN
UI_TEXT(kIoModeTip_Win,
        "IO 引擎固定为 windowsaio：Windows 上只有它支持 direct=1。\n"
        "同步引擎（psync / sync）只能用缓冲 I/O，测到的是系统缓存而不是磁盘，故不提供。")
#else
UI_TEXT(kIoModeTip_Posix,
        "Linux 上 direct=1 走的是 O_DIRECT，libaio / io_uring / psync 都支持。\n"
        "默认优先用 libaio：只有异步引擎才能让 iodepth 真正生效，\n"
        "性能项的 Q8T1 / Q32T1 靠它才测得准。\n"
        "如果这份 fio 没有编 libaio，启动时会自动退回可用的那个引擎。")
#endif
UI_TEXT(kLabelIoMode, "IO 方式")
UI_TEXT(kParamHint,
