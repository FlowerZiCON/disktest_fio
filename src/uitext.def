UI_TEXT(kErrFat32TooBig,
        "目标分区 %1 是 FAT 文件系统（FAT32 / vfat），单个文件最大只能到 4 GiB。\n\n"
        "测试数据大小选了 %2，单文件放不下。\n\n"
        "请改成 4 GiB 及以下，或者换一个支持大文件的文件系统"
        "（NTFS / exFAT / ext4 / xfs 都可以）。")
UI_TEXT(kLogPreallocating, "正在预建测试文件：%1 个 × %2")
UI_TEXT(kLogPreallocated, "测试文件已就绪，合计 %1")
UI_TEXT(kErrPerfNoItem, "请至少勾选一个测试项。")
UI_TEXT(kErrPerfDataSize, "测试数据大小必须大于 0。")
UI_TEXT(kModeGroupTitle, "测试模式")
UI_TEXT(kLogPreparingFiles, "准备中：正在预建测试文件 %1/%2")
UI_TEXT(kLogPerfPassDone, "%1 %2 完成：%3")
UI_TEXT(kTraceShownTip, "右边图表显示的是 %1 的读写曲线")
UI_TEXT(kTraceNoData, "这一项还没有数据。")
UI_TEXT(kTraceBusyTip, "测试进行中，结束后才能查看明细。")
UI_TEXT(kTraceClickTip, "点击在右边图表里显示这一项的读写曲线")
UI_TEXT(kErrPerfNoSpace, "目标分区剩余 %1，放不下 %2 的测试数据。")
UI_TEXT(kErrPreallocFailed, "预建测试文件失败")
/// Linux：tmpfs / overlayfs 之类不支持 O_DIRECT 的文件系统上，direct=1 的 job
/// 会以 "Operation not supported" 失败。这句话要在开测前就说清楚，
/// 否则用户只会看到一行 fio 报错，很难联想到是文件系统的问题。
UI_TEXT(kMsgNoDirectIoTitle, "文件系统不支持直接 I/O")
UI_TEXT(kErrNoDirectIo,
        "测试目录 %1 所在的文件系统不支持直接 I/O（O_DIRECT）：%2\n\n"
        "本工具固定用 direct=1 绕过系统缓存，测的才是磁盘本身。\n"
        "tmpfs、overlayfs 这类文件系统（/dev/shm、/run、容器里的根目录）\n"
        "不支持它，请换一个真实磁盘上的目录（ext4 / xfs / btrfs 都支持）。")
UI_TEXT(kLogPerfAllPlanned, "共 %1 项，预计 %2 秒")
UI_TEXT(kErrCreateJobFailed, "无法创建 job 文件")
