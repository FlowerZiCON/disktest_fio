UI_TEXT(kStatusSkippedLines, "（跳过 %1 行无法解析的数据）")
UI_TEXT(kStatusDiagnosticsSaved, "诊断输出已保存到 %1")
UI_TEXT(kStatusCleaningOldFiles, "正在清理旧的测试文件…")
UI_TEXT(kStatusWriting, "正在写入…")
UI_TEXT(kStatusReading, "正在读取…")
UI_TEXT(kStatusStopping, "正在停止…")

