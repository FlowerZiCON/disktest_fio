UI_TEXT(kDlgChooseFioTitle, "选择 fio 可执行文件")
#ifdef Q_OS_WIN
UI_TEXT(kFilterExecutable_Win, "可执行文件 (*.exe);;所有文件 (*)")
#else
/// Linux 上可执行文件**没有扩展名** —— 随包发布的那个就叫 `fio`。
/// 按 `*.exe` 过滤会把 fio 本身藏起来，对话框里一个文件都挑不到。
/// 权限位（可执行）没法用名字通配符表达，所以这里只能放开成全部文件。
UI_TEXT(kFilterExecutable_Posix, "所有文件 (*)")
#endif
