UI_TEXT(kResultWindowTitleFmt, "%1 - %2")
UI_TEXT(kResultModeLabelFmt, "测试模式：%1")
UI_TEXT(kResultSourceFmt, "数据来源：%1")
UI_TEXT(kResultSummaryTarget, "目标分区")
UI_TEXT(kResultSummaryMode, "读写模式")
