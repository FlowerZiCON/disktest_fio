// ── 状态栏 ──
UI_TEXT(kModeElevated, "提权模式")
UI_TEXT(kModeNormal, "普通模式")
// "提权"在两个平台上的含义不一样：Windows 是管理员令牌，
// Linux 上就是 euid == 0。Linux 下普通文件做 O_DIRECT 并不需要 root，
// 所以这句话只能说"以 root 身份运行"，不能说"必须提权才能测"。
#ifdef Q_OS_WIN
UI_TEXT(kModeElevatedTip_Win, "当前以管理员身份运行，可以访问需要提权的设备。")
UI_TEXT(kModeNormalTip_Win, "当前是普通权限。\n以管理员身份重新启动本程序即可进入提权模式。")
#else
UI_TEXT(kModeElevatedTip_Posix, "当前以 root 身份运行（euid 0）。")
UI_TEXT(kModeNormalTip_Posix,
        "当前是普通用户。\n"
        "测试普通文件不需要 root；只有目标目录本身没有写权限时才需要。")
#endif
UI_TEXT(kStatusSelectDriveHint, "请先在「选择磁盘」列表里选中要测试的分区")
UI_TEXT(kStatusCleanedFiles, "已清理 %1 个测试文件")
UI_TEXT(kStatusRunDataSaved, "已保存 %1 个采样点与本次参数到 %2")
