UI_TEXT(kErrIodepthTooSmall, "队列深度至少为 1。")
UI_TEXT(kErrTargetUnavailable, "目标分区不可用：%1")
UI_TEXT(kErrReadCapacity, "无法读取 %1 的容量信息。")
UI_TEXT(kErrNoDriveSelected, "没有选中分区")
UI_TEXT(kErrNoDriveSelectedDetail, "请先在「选择磁盘」列表里选中一个分区。")
UI_TEXT(kErrStopBeforeCleanup, "请先点「停止」再清理。")
UI_TEXT(kErrBusy, "正在测试中")
UI_TEXT(kErrNoTestFiles, "没有测试文件")
UI_TEXT(kErrNoTestFilesInFolder, "%1 里没有 testfile_* 文件。")
UI_TEXT(kErrCleanupFailed, "清理失败")
UI_TEXT(kErrNoDataToSave, "没有可保存的数据")
UI_TEXT(kErrNoSamplesYet, "还没有跑过测试，或者没有采到任何采样点。")
UI_TEXT(kErrLoadDataFailed, "打开测试结果失败")
/// 结果文件版本过旧：%1 = 文件路径，%2 = 文件自己的版本，%3 = 本程序要求的最低版本
UI_TEXT(kErrRunDataTooOld,
        "这份结果的版本过旧，本程序不再支持。\n\n"
        "文件：%1\n"
        "文件版本：%2\n"
        "本程序要求：%3 及以上\n\n"
        "请用当前版本重新跑一次测试并保存。")
/// 同上，但文件里根本没写版本（2.2.7 之前存的都没有）
UI_TEXT(kErrRunDataTooOldNoVersion,
        "这份结果的版本过旧，本程序不再支持。\n\n"
        "文件：%1\n"
        "文件版本：未记录（%2 之前的版本存的文件都不写版本号）\n\n"
        "请用当前版本重新跑一次测试并保存。")
UI_TEXT(kMsgBadCsvHeader, "%1\n第一行应当是 \"# %2\"，并且含 [samples] 数据段。")
/// 格式和版本都对，但一个采样行都没解析出来（数据段为空、或者整段坏掉）。
/// 这和"第一行不是标记"是两件事，分开说才不会把人引向错误的排查方向。
UI_TEXT(kErrRunDataNoSamples,
        "%1\n文件里有 [samples] 数据段，但没有任何一行能解析成采样点"
        "（跳过了 %2 行）。\n文件可能已损坏，或者不是本程序保存的结果。")
UI_TEXT(kErrBusyLoading, "正在测试中，请先点「停止」再加载历史数据。")
/// 目标是裸设备 / 物理磁盘路径。本工具只做文件模式，这类路径一律拒绝。
UI_TEXT(kErrTargetIsRawDevice,
        "目标不能是裸设备或物理磁盘：\n%1\n\n"
        "本工具只在普通文件上做测试，请选择一个分区里的可写目录。")
/// 覆盖/清理确认框里补一句：除了测试文件，还有 fio 留下的校验状态文件会被删。
/// %1 = 个数，%2 = 合计大小
UI_TEXT(kMsgAlsoStateFiles, "\n另外还会删除 %1 个 fio 校验状态文件（%2）。")
UI_TEXT(kErrNoContentToSave, "没有可保存的内容")
UI_TEXT(kErrNoOutputYet, "还没有跑过测试，或者 fio 没有产生输出。")
UI_TEXT(kErrDeleteOldFiles, "无法删除旧文件：%1")
UI_TEXT(kErrCreateFolder, "无法创建测试目录：%1")
UI_TEXT(kMsgSelfTestTargetMismatch,
        "自检指定的是 %1，但当前选中的是 %2。\n"
        "已中止，没有写入任何数据。")
UI_TEXT(kErrTargetMismatch, "目标分区不匹配")
UI_TEXT(kErrBadParams, "参数有误")
UI_TEXT(kErrFioNotFound, "找不到 fio")
#ifdef Q_OS_WIN
UI_TEXT(kErrSpecifyFioPath_Win, "请先指定 fio.exe 的路径。")
#else
UI_TEXT(kErrSpecifyFioPath_Posix, "请先指定 fio 的路径。")
#endif
UI_TEXT(kErrNoTestFilesForRead,
        "%1 里没有 testfile_* 文件，无法单独执行读取。\n"
        "请先勾选「写入」跑一次。")
UI_TEXT(kErrReadCapacityFailed, "读取容量失败")
UI_TEXT(kErrNoSpace, "空间不足")
UI_TEXT(kErrNoWritableSpace, "目标分区剩余 %1，没有可写的空间。")
UI_TEXT(kErrCleanupOldFailed, "清理旧文件失败")
UI_TEXT(kErrCreateFolderFailed, "创建测试目录失败")
UI_TEXT(kErrCreateJobFile, "无法创建 job 文件")
UI_TEXT(kErrStartWritePhase, "启动写入阶段失败")
UI_TEXT(kErrNoTestFilesAtReadStart, "读取阶段开始时 %1 里没有 testfile_* 文件。")
UI_TEXT(kErrStartReadPhase, "启动读取阶段失败")

// ── fio 运行与告警 ──
UI_TEXT(kProblemOpenFailed, "fio 报告有文件打开失败（failed to open）")
UI_TEXT(kProblemIoUnitError, "fio 报告 I/O 单元错误（io_u error）")
UI_TEXT(kProblemPermissionDenied, "fio 报告权限不足（Permission denied）")
UI_TEXT(kProblemNoSpaceLeft, "目标分区空间不足（No space left on device）")
UI_TEXT(kProblemBadOption, "fio 拒绝了某个选项（Bad option）")
UI_TEXT(kProblemJobGlobalDropped, "fio 丢弃了 job 里的全局选项（job global dropped）")
UI_TEXT(kProblemCannotOpen, "fio 无法打开目标（cannot open）")
UI_TEXT(kProblemBadMagicHeader, "★ 数据校验失败：块的校验头不匹配，磁盘上的内容与写入时不一致")
UI_TEXT(kProblemVerifyFailed, "★ 数据校验失败（verify failed）")
UI_TEXT(kProblemIllegalByteSequence, "★ I/O 返回非法字节序列，通常是校验不一致")

// ── 校验失败的大字告警（测试阶段显示在右侧图表区上方）──
/// 唯一的一行：最要紧的一句。%1 = 已经发现的坏块数
UI_TEXT(kVerifyBannerHead, "⚠ 数据校验失败：已发现 %1 处不一致")
/// 第二行：只说结论和该做什么，不摆 fio 原话——偏移量在日志里有逐处明细。
UI_TEXT(kVerifyBannerNote, "该磁盘存在问题，请尽快备份数据并更换该盘。")
/// 结果窗口专用：文件里的坏块计数**读不出来**（字段坏了）。
/// 这一种不能按"0 处"处理——那等于把"这块盘坏了"的结论抹掉。
UI_TEXT(kVerifyCountUnreadable, "⚠ 数据校验结果无法读取：结果文件里的坏块计数已损坏")
UI_TEXT(kVerifyCountUnreadableNote, "无法判断当时有没有发现坏块，建议用当前版本重新测试一次。")
/// 结果窗口专用：告警说 N 处，但文件里只留下了前几条明细时补一句。
/// %1 = 明细条数，%2 = 记录的总处数
UI_TEXT(kResultVerifyDetailsShort, "（结果文件里只留下了前 %1 处明细，当时记录的总数是 %2 处）")
/// 日志里每发现一块坏块记一行：%1 = 第几块，%2 = fio 原话
UI_TEXT(kLogVerifyFailure, "校验失败第 %1 处：%2")
/// 阶段结束时把总数写进日志：%1 = 总块数
UI_TEXT(kLogVerifySummary, "★ 本阶段共发现 %1 处数据校验失败")
/// 逐处明细被截断时补一句：%1 = 记了多少条，%2 = 总共多少处
UI_TEXT(kLogVerifyTruncated, "（上面只列出前 %1 处，本次共 %2 处）")
/// 图表上能标的坏块位置到了上限：%1 = 上限，%2 = 没标出来的处数
UI_TEXT(kLogVerifyMarkersTruncated,
        "（图表上最多标 %1 处坏块位置，本次还有 %2 处没在图上标出来；"
        "运行日志与保存的结果文件里是全的）")
UI_TEXT(kLogVerifyNone, "数据校验通过：没有发现不一致的块")
/// 一个阶段跑完了，却既没有采样点、也没有 fio 的读写汇总：很可能**什么都没测**。
/// 实测：测试目录里残留的文件比块大小还小，fio 一次 I/O 都没发，退出码却是 0，
/// 于是"什么都没测"看起来和"测过了没问题"一模一样。只写日志、不改结论 ——
/// 汇总的解析依赖 fio 的输出格式，拿它去判 FAIL 有可能误伤好盘。
UI_TEXT(kLogPhaseDidNothing,
        "★ %1没有产生任何 I/O（既没有采样，也没有 fio 汇总）——"
        "这一阶段很可能什么都没测到：请确认测试文件完整、且大于块大小。")
/// 报告里的校验失败行：%1 = 第几处，%2 = fio 原话
UI_TEXT(kReportVerifyLine, "*** 数据校验失败第 %1 处: %2")
UI_TEXT(kStatusVerifyFailed, "★ 已发现 %1 处数据校验失败")
/// 自检报告里的校验失败统计
UI_TEXT(kReportVerifyCount, "  校验失败块数      : ")
UI_TEXT(kReportVerifyFirst, "  首处失败原话      : ")
UI_TEXT(kReportVerifyWhere, "      · ")
UI_TEXT(kReportVerifyTruncated, "      （上面只列出前 %1 处，本次共 %2 处）")
/// 开发排查：强制显示告警条时的标记（必须在界面和日志里说明这是伪造的）
UI_TEXT(kLogDebugBannerForced, "【开发排查】校验失败告警条是**强制显示**的示例，不是本次真实结果")
UI_TEXT(kDebugBannerTitleSuffix, "  [告警条为示例]")
UI_TEXT(kErrNoTempDir, "找不到可写的临时目录。")
UI_TEXT(kErrWriteJobFile, "无法写入 job 文件：\n%1\n%2")
UI_TEXT(kErrPhaseRunning, "已经有一个阶段在运行。")
UI_TEXT(kErrFioNotSpecified, "找不到 fio 可执行文件，请在界面上指定路径。")
UI_TEXT(kFioWorkingDir, "  (工作目录: %1)")
UI_TEXT(kErrFioStartFailed, "无法启动 fio：%1")
UI_TEXT(kFioIocounterUnavailable, "提示：无法读取 fio 进程 I/O 计数，实时曲线将不可用。")
UI_TEXT(kFioUserStop, "… 用户请求停止")
UI_TEXT(kFioTestFinished, "… 测试已结束（%1），停止采样")
